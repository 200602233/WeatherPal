<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WeatherPal" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/green</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="android:colorBackground">@color/lightgreen</item>
        <!-- headline -->
        <item name="textAppearanceHeadlineMedium">
            @style/TextAppearance.Material3.HeadlineMedium
        </item>
        <!-- body -->
        <item name="textAppearanceBodyMedium">
            @style/TextAppearance.Material3.BodyMedium
        </item>

        <!-- Disable the android green icon from loading before splash -->
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- Splash theme (may change after next weeks class) -->
    <style name="Theme.WeatherPal.SplashActivity" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">
            @color/green <!-- change later, just for testing -->
        </item>
    </style>

    <!-- Headline -->
    <style name="TextAppearance.Material3.HeadlineMedium.">
        <item name="android:textSize">25sp</item>
    </style>
    <!-- Body -->
    <style name="TextAppearance.Material3.BodyMedium.">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Theme.WeatherPal" parent="Base.Theme.WeatherPal" />
</resources>